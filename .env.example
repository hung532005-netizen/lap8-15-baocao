# URL RPC mang Sepolia (Alchemy, Infura hoac PublicNode)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private Key cua vi Admin dung de deploy (64 ky tu hex, can co it nhat 0.02 SepoliaETH)
DEPLOYER_PRIVATE_KEY=0xYourPrivateKeyHereWithoutSharing

# Dia chi vi Trong tai KTX va vi nhan phi nen tang (Neu de trong se mac dinh lay vi Deployer)
ARBITER_ADDRESS=0xYourArbiterWalletAddress
FEE_RECIPIENT_ADDRESS=0xYourFeeRecipientWalletAddress

# API Key Etherscan de tu dong verify ma nguon Solidity (Tuy chon)
ETHERSCAN_API_KEY=YourEtherscanApiKey
